// ==============================================================================
// CFM Quote Tool - Cloud Firestore Security Rules
// ==============================================================================
// Paste these rules in your Firebase Console:
// Build -> Firestore Database -> Rules -> Publish
// ==============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quotes collection: Users can only read, create, update, and delete their own quotes
    match /quotes/{quoteId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
  }
}
